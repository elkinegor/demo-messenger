[Unit]
Description=demo-messenger (MAX/Telegram GREEN-API UI)
After=network.target

[Service]
Type=simple
WorkingDirectory=/opt/demo-messenger
Environment=NODE_ENV=production
Environment=PORT=3210
ExecStart=/usr/bin/node dist-server/index.js
Restart=on-failure
RestartSec=3
User=root

# Logs also go to WorkingDirectory/logs/app.log from the app.

[Install]
WantedBy=multi-user.target
